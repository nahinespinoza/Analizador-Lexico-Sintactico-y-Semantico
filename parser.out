Grammar

Rule 0     S' -> program
Rule 1     program -> program statement
Rule 2     program -> statement
Rule 3     statement -> LOCAL ID ASSIGN value
Rule 4     statement -> ID ASSIGN value
Rule 5     value -> NIL
Rule 6     expression -> expression GT expression
Rule 7     expression -> expression LT expression
Rule 8     expression -> expression GE expression
Rule 9     expression -> expression LE expression
Rule 10    expression -> expression EQ expression
Rule 11    expression -> expression NE expression
Rule 12    statement -> IF expression THEN program elseif_list else_part END
Rule 13    else_part -> ELSE program
Rule 14    else_part -> empty
Rule 15    elseif_list -> elseif_list elseif_clause
Rule 16    elseif_list -> empty
Rule 17    elseif_clause -> ELSEIF expression THEN program
Rule 18    expression -> NUMBER
Rule 19    expression -> STRING
Rule 20    expression -> TRUE
Rule 21    expression -> FALSE
Rule 22    expression -> ID
Rule 23    empty -> <empty>
Rule 24    statement -> FUNCTION ID LPAREN param_list RPAREN program END
Rule 25    statement -> FUNCTION ID LPAREN param_list RPAREN program RETURN expression END
Rule 26    statement -> FUNCTION ID LPAREN param_list RPAREN empty RETURN expression END
Rule 27    param_list -> param_list COMMA ID
Rule 28    param_list -> ID
Rule 29    param_list -> empty
Rule 30    statement -> ID LPAREN print_args RPAREN
Rule 31    print_args -> print_args COMMA value
Rule 32    print_args -> value
Rule 33    print_args -> empty
Rule 34    value -> expression
Rule 35    expression -> expression PLUS expression
Rule 36    expression -> expression MINUS expression
Rule 37    expression -> expression TIMES expression
Rule 38    expression -> expression DIVIDE expression
Rule 39    expression -> expression MOD expression
Rule 40    expression -> expression POWER expression
Rule 41    expression -> MINUS expression
Rule 42    expression -> LPAREN expression RPAREN
Rule 43    expression -> expression CONCAT expression
Rule 44    statement -> WHILE expression DO program END
Rule 45    statement -> FOR ID ASSIGN expression COMMA expression DO program END
Rule 46    statement -> FOR ID ASSIGN expression COMMA expression COMMA expression DO program END
Rule 47    value -> LBRACE table_fields RBRACE
Rule 48    table_fields -> table_fields COMMA table_field
Rule 49    table_fields -> table_field
Rule 50    table_fields -> empty
Rule 51    table_field -> ID ASSIGN value
Rule 52    expression -> ID LBRACKET value RBRACKET
Rule 53    value -> ID DOT ID LPAREN RPAREN

