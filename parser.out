Grammar

Rule 0     S' -> program
Rule 1     program -> program statement
Rule 2     program -> statement
Rule 3     statement -> LOCAL ID ASSIGN value
Rule 4     statement -> ID ASSIGN value
Rule 5     value -> NUMBER
Rule 6     value -> STRING
Rule 7     value -> TRUE
Rule 8     value -> FALSE
Rule 9     value -> NIL
Rule 10    value -> ID
Rule 11    expression -> expression GT expression
Rule 12    expression -> expression LT expression
Rule 13    expression -> expression GE expression
Rule 14    expression -> expression LE expression
Rule 15    expression -> expression EQ expression
Rule 16    expression -> expression NE expression
Rule 17    statement -> IF expression THEN program elseif_list else_part END
Rule 18    else_part -> ELSE program
Rule 19    else_part -> empty
Rule 20    elseif_list -> elseif_list elseif_clause
Rule 21    elseif_list -> empty
Rule 22    elseif_clause -> ELSEIF expression THEN program
Rule 23    expression -> NUMBER
Rule 24    expression -> STRING
Rule 25    expression -> TRUE
Rule 26    expression -> FALSE
Rule 27    expression -> ID
Rule 28    empty -> <empty>
Rule 29    statement -> FUNCTION ID LPAREN param_list RPAREN program END
Rule 30    param_list -> param_list COMMA ID
Rule 31    param_list -> ID
Rule 32    param_list -> empty
Rule 33    statement -> ID LPAREN print_args RPAREN
Rule 34    print_args -> print_args COMMA value
Rule 35    print_args -> value
Rule 36    print_args -> empty

