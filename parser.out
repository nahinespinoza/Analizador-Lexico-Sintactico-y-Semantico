Rule 7     expression -> expression GT expression
Rule 8     expression -> expression LT expression
Rule 9     expression -> expression GE expression
Rule 10    expression -> expression LE expression
Rule 11    expression -> expression EQ expression
Rule 12    expression -> expression NE expression
Rule 13    statement -> IF expression THEN program elseif_list else_part END
Rule 14    else_part -> ELSE program
Rule 15    else_part -> empty
Rule 16    elseif_list -> elseif_list elseif_clause
Rule 17    elseif_list -> empty
Rule 18    elseif_clause -> ELSEIF expression THEN program
Rule 19    expression -> NUMBER
Rule 20    expression -> STRING
Rule 21    expression -> TRUE
Rule 22    expression -> FALSE
Rule 23    expression -> ID
Rule 24    empty -> <empty>
Rule 25    statement -> FUNCTION ID LPAREN param_list RPAREN program END
Rule 26    statement -> FUNCTION ID LPAREN param_list RPAREN program RETURN expression END
